# Copy this file to .env and fill in real values. Never commit the real .env.

# Django
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=change-me-to-a-random-50-char-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database — leave DATABASE_URL unset locally to use SQLite automatically.
# For production (Docker Compose / real deployment) use PostgreSQL.
# DB_PASSWORD is used by docker-compose.yml to build DATABASE_URL automatically.
DB_PASSWORD=change-me
# DATABASE_URL=postgres://usermanager_app:change-me@db:5432/usermanager

# Redis / Celery
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1

# Credential encryption — generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=

# i18n
LANGUAGE_CODE=fa
TIME_ZONE=Asia/Tehran

# Login throttling
LOGIN_FAILURE_LIMIT=5
LOGIN_COOLOFF_SECONDS=300

# Production only (config/settings/prod.py) — set to False until you have a
# domain + TLS certificate in front of the panel, then switch it to True.
ENABLE_SSL=True
